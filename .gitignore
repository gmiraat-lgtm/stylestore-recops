# Virtual environment
venv/

# Python junk
__pycache__/
*.pyc

# MLflow local tracking
mlruns/
mlartifacts/
mlflow.db
*.db

# DVC internals (DVC manages its own ignores too, this is belt-and-braces)
.dvc/cache/
.dvc/tmp/

# Models are DVC-tracked; DVC writes its own .gitignore entries beside data files
models/*
!models/*.dvc

# Reports generated at runtime
reports/generated/ab_events.csv

# OS / editor noise
.vscode/
Thumbs.db
desktop.ini

# Records are local only (screenshots, large)
records/

